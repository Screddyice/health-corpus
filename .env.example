# Copy this to .env and fill in. Never commit .env (already in .gitignore).

# ─── Apple Health Auto Export (required for monitor) ──────────────────────
APPLE_HEALTH_REMOTE_BASE_URL=https://your-hae-server.example.com
APPLE_HEALTH_REMOTE_READ_TOKEN=sk-your-hae-token
# Optional JSON fallback: ~/.health-corpus/apple_health_remote.json
# HEALTH_CORPUS_HAE_CONFIG=~/.health-corpus/apple_health_remote.json

# ─── Telegram delivery (required for alerts/digests) ──────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-replace-this
TELEGRAM_CHAT_ID=000000000

# ─── Chat endpoint for digest generation ──────────────────────────────────
# POST {url} with {"message": "..."} → {"answer": "..."}
HEALTH_CORPUS_CHAT_URL=http://127.0.0.1:8200/chat
HEALTH_CORPUS_CHAT_TOKEN=replace-with-your-bearer-token

# ─── Durable corpus store (recommended) ───────────────────────────────────
# When set, the monitor upserts into health_metrics and MCP tools can read
# bounded windows/trends. Apply schema with:
#   uv run python -m health_corpus.migrations
DATABASE_URL=postgresql://user:pass@host:5432/health_corpus
# HEALTH_CORPUS_DATABASE_URL=postgresql://user:pass@host:5432/health_corpus
HEALTH_CORPUS_DEFAULT_SUBJECT=self
# HEALTH_CORPUS_SUBJECTS_CONFIG=./config/subjects.yaml
# HEALTH_CORPUS_ACTOR=health-corpus

# ─── MCP local LLM breakdown (optional) ───────────────────────────────────
# HEALTH_CORPUS_LLM_URL=http://127.0.0.1:8801/v1/chat/completions
# HEALTH_CORPUS_LLM_MODEL=local-health-model

# ─── Email mirror (optional) ──────────────────────────────────────────────
# HEALTH_CORPUS_EMAIL_TO=you@example.com
# HEALTH_CORPUS_EMERGENCY_EMAIL_TO=emergency-only@example.com
# HEALTH_CORPUS_SICKNESS_EMAIL_TO=sickness-only@example.com

# ─── Path + timezone overrides (optional) ─────────────────────────────────
# HEALTH_CORPUS_JSONL_LOG_PATH=~/logs/health-corpus-monitor.jsonl
# HEALTH_CORPUS_STATE_DIR=~/health-corpus/state
# HEALTH_CORPUS_TZ=America/Los_Angeles
