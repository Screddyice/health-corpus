[Unit]
Description=Twice-weekly Health Corpus digest — Tue 12:00 + Sun 16:00 local
Requires=health-digest.service

[Timer]
# Both fires happen AFTER the daily monitor so the digest reads the
# freshly-written JSONL entry. Adjust the timezone to match your
# HEALTH_CORPUS_TZ env var.
OnCalendar=Tue 12:00:00 America/Los_Angeles
OnCalendar=Sun 16:00:00 America/Los_Angeles
Persistent=true

[Install]
WantedBy=timers.target
