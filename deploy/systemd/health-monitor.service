[Unit]
Description=Health Corpus daily monitor — analysis + tiered edge-trigger alerts
After=network.target

[Service]
Type=oneshot
# Adjust paths for your install. %h expands to the running user's home directory.
EnvironmentFile=%h/health-corpus/.env
WorkingDirectory=%h/health-corpus
ExecStart=%h/.local/bin/uv run python -m health_corpus.agents.health_monitor
StandardOutput=append:%h/logs/health-corpus-monitor.log
StandardError=append:%h/logs/health-corpus-monitor.log

[Install]
WantedBy=default.target
