[Unit]
Description=Health Corpus twice-weekly narrative digest
After=network.target

[Service]
Type=oneshot
EnvironmentFile=%h/health-corpus/.env
WorkingDirectory=%h/health-corpus
ExecStart=%h/.local/bin/uv run python -m health_corpus.agents.health_digest
StandardOutput=append:%h/logs/health-corpus-digest.log
StandardError=append:%h/logs/health-corpus-digest.log

[Install]
WantedBy=default.target
